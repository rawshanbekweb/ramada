# Nusxa oling: cp .env.example .env  va qiymatlarni to'ldiring.
DOMAIN=qabul.example.uz
POSTGRES_PASSWORD=uzun-tasodifiy-parol

SQ_BASE_URL=https://qabul.example.uz
SQ_SECRET_KEY=kamida-32-belgili-tasodifiy-satr-openssl-rand-hex-32
SQ_TIMEZONE=Asia/Tashkent

# Telegram (@BotFather)
SQ_TELEGRAM_BOT_TOKEN=

# SMS: console (sinov) yoki eskiz
SQ_SMS_PROVIDER=console
SQ_SMS_ESKIZ_EMAIL=
SQ_SMS_ESKIZ_PASSWORD=
SQ_SMS_ESKIZ_FROM=4546

# Edge agent bilan umumiy maxfiy kalit (edge/config.toml dagi edge_secret bilan bir xil)
SQ_EDGE_SECRET=
