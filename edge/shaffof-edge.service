[Unit]
Description=Shaffof qabul — edge agent (kameralar)
After=network-online.target
Wants=network-online.target

[Service]
User=shaffof
WorkingDirectory=/opt/shaffof-edge
ExecStart=/opt/shaffof-edge/.venv/bin/python -m edge.agent --config edge/config.toml
Restart=always
RestartSec=5
# Elektr o'chib yonsa ham avtomatik ishga tushadi; navbat edge/edge.queue.db da saqlanadi
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
